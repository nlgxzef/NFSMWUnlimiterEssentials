// Common, Neon and Tire packs cannot be uninstalled as they are/were a core component of ULv4.

// ----------------------------------------------------------------------------

// Paint
combobox "Yes" "No" "Uninstall Paint Pack?"

"Yes"
append Uninstall\Paint\Paint.endscript

"No"
// do nothing

end

