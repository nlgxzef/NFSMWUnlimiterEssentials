if file_exists absolute Languages\Swedish.bin
do
new negate Languages\Swedish.bin

add_or_update_string Languages\Swedish.bin STRBlocks GLOBAL AUTO PN_TIRE_01 "Stock"
add_or_update_string Languages\Swedish.bin STRBlocks GLOBAL AUTO PN_TIRE_02 "Retro"
add_or_update_string Languages\Swedish.bin STRBlocks GLOBAL AUTO PN_TIRE_03 "Carbon"
add_or_update_string Languages\Swedish.bin STRBlocks GLOBAL AUTO PN_TIRE_04 "Carbon Retro"

delete Languages\Swedish.bin
else // do nothing
end