if file_exists absolute Languages\Italian.bin
do
new negate Languages\Italian.bin

add_or_update_string Languages\Italian.bin STRBlocks GLOBAL AUTO PN_TIRE_01 "Stock"
add_or_update_string Languages\Italian.bin STRBlocks GLOBAL AUTO PN_TIRE_02 "Retro"
add_or_update_string Languages\Italian.bin STRBlocks GLOBAL AUTO PN_TIRE_03 "Carbon"
add_or_update_string Languages\Italian.bin STRBlocks GLOBAL AUTO PN_TIRE_04 "Carbon Retro"

delete Languages\Italian.bin
else // do nothing
end