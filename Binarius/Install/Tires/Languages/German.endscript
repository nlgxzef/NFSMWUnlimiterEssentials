if file_exists absolute Languages\German.bin
do
new negate Languages\German.bin

add_or_update_string Languages\German.bin STRBlocks GLOBAL AUTO PN_TIRE_01 "Stock"
add_or_update_string Languages\German.bin STRBlocks GLOBAL AUTO PN_TIRE_02 "Retro"
add_or_update_string Languages\German.bin STRBlocks GLOBAL AUTO PN_TIRE_03 "Carbon"
add_or_update_string Languages\German.bin STRBlocks GLOBAL AUTO PN_TIRE_04 "Carbon Retro"

delete Languages\German.bin
else // do nothing
end