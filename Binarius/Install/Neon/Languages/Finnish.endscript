add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_AQUA "Aqua"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_WHITE "Valkoinen"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_GRAPE "Koralli"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_PINK "Magenta"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_LIME "Lime"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_LAVENDER "Violetti"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_GOLD "Kulta"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_RED_PULSE "Punainen Pulssi"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_GREEN_PULSE "Vihreä Pulssi"
