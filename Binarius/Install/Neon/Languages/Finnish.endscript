if file_exists absolute Languages\Finnish.bin
do
new negate Languages\Finnish.bin

add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_NONE "Ei Neon"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_RED "Punainen"
add_or_update_string Languages\Finnish.bin STRBlocks GLOBAL AUTO PN_NEON_GREEN "Vihreä"
