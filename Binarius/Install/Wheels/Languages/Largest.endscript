if file_exists absolute Languages\Largest.bin
do
new negate Languages\Largest.bin

add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_GIOVANNA "Giovanna"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_IFORGED "IFORGED"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_WORK "Work"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_TENZO "Tenzo"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_AR "American Racing"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_CL "Center-Line"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_HRE "HRE"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_TSW "TSW"
add_or_update_string Languages\Largest.bin STRBlocks GLOBAL AUTO CO_RIM_BRAND_FOOSE "Foose"

delete Languages\Largest.bin
else // do nothing
end