if file_exists absolute Languages\Mexican.bin
do
new negate Languages\Mexican.bin

add_or_update_string Languages\Mexican.bin STRBlocks GLOBAL AUTO CP_FILTER_GLOSS_BETA "Satinado (Beta)"
add_or_update_string Languages\Mexican.bin STRBlocks GLOBAL AUTO CP_FILTER_METALLIC_BETA "Metalizado (Beta)"
add_or_update_string Languages\Mexican.bin STRBlocks GLOBAL AUTO CP_FILTER_PEARL_BETA "Personalizado (Beta)"
add_or_update_string Languages\Mexican.bin STRBlocks GLOBAL AUTO CP_FILTER_RIM_BETA "Capa pulverizada (Beta)"
add_or_update_string Languages\Mexican.bin STRBlocks GLOBAL AUTO CP_FILTER_RIM_CUSTOM "Capa pulverizada (Personalizado)"
add_or_update_string Languages\Mexican.bin STRBlocks GLOBAL AUTO CP_FILTER_RIM_UNUSED "Capa pulverizada (No usado)"

delete Languages\Mexican.bin
else // do nothing
end