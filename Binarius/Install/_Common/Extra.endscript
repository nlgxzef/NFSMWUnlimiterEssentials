// CarParts
import override Global\GlobalB.lzc DBModelParts "Install\_Common\CarParts\EXTRA.BIN"

// Textures
if collection_exists Global\GlobalB.lzc TPKBlocks DEFAULT
do
update_collection Global\GlobalB.lzc TPKBlocks DEFAULT CollectionName GLOBALTEXTURES
else // do nothing
end

bind_textures synchronize Global\GlobalB.lzc TPKBlocks GLOBALTEXTURES "Install\_Common\GlobalTextures"

